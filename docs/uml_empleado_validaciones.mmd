classDiagram
    class Empleado {
        <<base>>
        +TIPO: str
        +MIN_NOMBRE: int = 2
        +MAX_NOMBRE: int = 100
        +MIN_CORREO: int = 6
        +MAX_CORREO: int = 150
        +id: int
        +nombre: str
        -_correo: str
        +validar_nombre(nombre: str)$ str
        +validar_correo(correo: str)$ str
        +cambiar_correo(nuevo_correo: str) None
        +calcular_salario() float
        +obtener_detalles() str
    }

    class EmpleadoPlanta {
        +bono_anual: float
        +calcular_salario() float
    }

    class EmpleadoContrata {
        +tarifa_hora: float
        +calcular_salario() float
    }

    Empleado <|-- EmpleadoPlanta
    Empleado <|-- EmpleadoContrata

    class Indicador {
        +codigo: str
        +fuente: str
        +fecha: date
        +valor: float
        +unidad: str
        +verificado_en: datetime
    }

    class IndicadorDAO {
        +guardar_o_actualizar(indicador)
        +listar()
        +buscar_ultimo()
    }

    class ProyectoDAO {
        +listar_por_empleado(id_empleado)
        +empleado_asignado(id_proyecto, id_empleado)
    }

    class RegistroTiempo {
        +empleado_id: int
        +proyecto_id: int
        +horas: float
        +fecha: date
    }

    IndicadorDAO ..> Indicador : persiste
    ProyectoDAO ..> Empleado : verifica asignación
    RegistroTiempo --> Empleado
    RegistroTiempo --> Proyecto
    Proyecto "0..*" -- "0..*" Empleado : proyecto_empleado
